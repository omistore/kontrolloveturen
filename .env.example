PORT=3001
POSTGRES_USER=veturecheck
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://veturecheck:replace-with-local-password@localhost:5432/veturecheck
DATABASE_SSL=false
CORS_ORIGIN=

# Generate a long random value for production; do not commit real credentials.
ADMIN_ACCESS_TOKEN=

# Keep disabled until CheckCar.VIN grants API access and reseller authorization.
CHECKCAR_VIN_ENABLED=false
CHECKCAR_VIN_API_URL=
CHECKCAR_VIN_API_KEY=

# Payment integration is intentionally not configured; no successful payments are simulated.
PAYMENT_PROVIDER=disabled
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Bank transfer details shown to customers on the payment page.
BANK_IBAN=
BANK_BIC=
BANK_ACCOUNT_HOLDER=
